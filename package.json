{
  "name": "decision-memory",
  "version": "1.0.0",
  "description": "Decision Memory for Jira: capture team decisions and flag new work that contradicts them. Forge + Rovo + MCP + Teamwork Graph.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.js\"",
    "lint": "forge lint",
    "check": "npm test && forge lint",
    "deploy": "forge deploy -e development",
    "install:site": "forge install -e development --product jira"
  },
  "dependencies": {
    "@forge/api": "^6.0.0",
    "@forge/bridge": "^5.0.0",
    "@forge/kvs": "^2.1.1",
    "@forge/react": "^11.0.0",
    "@forge/resolver": "^1.6.0",
    "@forge/sql": "^3.0.0",
    "@forge/teamwork-graph": "^5.3.2",
    "react": "^18.3.1"
  }
}
